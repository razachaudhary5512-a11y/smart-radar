# ============================================================
# Be Alert — Environment Variables Template
# ============================================================
# Safe to commit — contains NO real secrets.
# Copy to .env and fill in your values.
#
# ⚠️  Every VITE_* value is compiled into the public JavaScript
#     bundle. Only put PUBLIC values here. Server secrets (e.g. the
#     Supabase service_role key, SMTP passwords) belong in the
#     Supabase dashboard, never here.
#     The build fails on purpose if one is set with a VITE_ prefix.
# ============================================================

# ----------------------------------------------------------
# DATA MODE
#   auto (default) — use Supabase when reachable, else demo data
#   demo           — always use in-browser demo data
#   live           — always use Supabase (no fallback)
# ----------------------------------------------------------
VITE_DATA_MODE=auto

# ----------------------------------------------------------
# SUPABASE (required for live mode)
# https://supabase.com → Project Settings → API
# ----------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ----------------------------------------------------------
# GOOGLE MAPS (optional — app uses Leaflet/OpenStreetMap by default)
# ----------------------------------------------------------
VITE_GOOGLE_MAPS_API_KEY=

# ----------------------------------------------------------
# FIREBASE — Push notifications (optional; all 6 needed together)
# https://console.firebase.google.com → Project Settings → Your apps
# VAPID key: Project Settings → Cloud Messaging → Web Push certificates
# ----------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# ----------------------------------------------------------
# CLOUDFLARE TURNSTILE (optional CAPTCHA on sign-in)
# Only set this after enabling CAPTCHA in Supabase → Auth → Attack Protection.
# ----------------------------------------------------------
VITE_TURNSTILE_SITE_KEY=

# ----------------------------------------------------------
# PUBLIC URL of the website (used for links inside the Android app)
# ----------------------------------------------------------
VITE_PUBLIC_URL=
