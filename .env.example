# ============================================================
# Smart Radar — Environment Variables Template
# ============================================================
# ✅ Safe to commit — contains NO real secrets.
# Copy this file to .env and fill in your real values.
# ============================================================

# ----------------------------------------------------------
# SUPABASE (Required)
# https://supabase.com → Project Settings → API
# ----------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ----------------------------------------------------------
# GOOGLE MAPS (Optional — app uses Leaflet/OSM by default)
# https://console.cloud.google.com → APIs & Services → Credentials
# Enable: Maps JavaScript API, Places API
# ----------------------------------------------------------
VITE_GOOGLE_MAPS_API_KEY=

# ----------------------------------------------------------
# FIREBASE — Push Notifications (Optional)
# https://console.firebase.google.com → Project Settings → Your apps → Web app
# ----------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ----------------------------------------------------------
# TWILIO — Custom SMS (Optional)
# Supabase phone auth is used by default. Only add these if
# you need custom-branded SMS messages via a Supabase Edge Function.
# https://console.twilio.com → Account Info
# ⚠️  These values are proxied server-side — never exposed directly.
# ----------------------------------------------------------
VITE_TWILIO_ACCOUNT_SID=
VITE_TWILIO_AUTH_TOKEN=
VITE_TWILIO_PHONE_NUMBER=

# ----------------------------------------------------------
# PAYMENTS — JazzCash / EasyPaisa (Not activated yet)
# Add values here when you are ready to go live with payments.
# See src/services/payments.ts for the activation checklist.
# ----------------------------------------------------------
VITE_JAZZCASH_MERCHANT_ID=
VITE_JAZZCASH_PASSWORD=
